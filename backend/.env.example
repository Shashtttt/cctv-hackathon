# IBVAP Environment Configuration Template
# Copy to backend/.env and fill in values for your deployment.

# ── Platform ──────────────────────────────────────────────────────────────────
ENV=development          # development | production

# ── Security ──────────────────────────────────────────────────────────────────
# CHANGE THIS to a cryptographically random string in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_KEY

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI Models ─────────────────────────────────────────────────────────────────
# Place model weights in the models/ directory at project root.
# Download from:
#   YOLOv8n-pose: https://github.com/ultralytics/assets/releases/download/v8.2.0/yolov8n-pose.pt
#   YuNet:        https://github.com/opencv/opencv_zoo/blob/main/models/face_detection_yunet/
#   SFace:        https://github.com/opencv/opencv_zoo/blob/main/models/face_recognition_sface/

YOLO_POSE_MODEL=models/yolov8n-pose.pt
YOLO_OBJECT_MODEL=models/yolov8n.pt
YOLO_WEAPON_MODEL=models/weapon_yolov8n.pt
YOLO_LP_MODEL=models/yolov8n-lp.pt
YUNET_FACE_MODEL=models/face_detection_yunet_2023mar.onnx
SFACE_FACE_MODEL=models/face_recognition_sface_2021dec.onnx

# ── AI Thresholds ─────────────────────────────────────────────────────────────
YOLO_CONFIDENCE_THRESHOLD=0.45
FRS_SIMILARITY_THRESHOLD=0.40
ANPR_OCR_CONFIDENCE=0.60
ANPR_FUZZY_DISTANCE=2

# ── GPU ───────────────────────────────────────────────────────────────────────
USE_GPU=false        # Set to true if CUDA GPU is available
GPU_DEVICE=cpu       # cpu | 0 | 0,1

# ── Surveillance Behaviour ────────────────────────────────────────────────────
LOITERING_TIMEOUT_SECONDS=10.0
ALERT_THROTTLE_SECONDS=3.0
MAX_CAMERAS=64
FRAME_SKIP_RATIO=2        # Process 1 in every N frames (1 = all frames)

# ── Storage ───────────────────────────────────────────────────────────────────
SNAPSHOT_DIR=snapshots
SNAPSHOT_JPEG_QUALITY=75
MAX_SNAPSHOT_RETENTION_DAYS=30
