# Environment Configuration Template
# Copy to backend/.env and fill in values for your deployment.

# Platform
ENV=development

# Security
API_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_KEY
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Models
YOLO_POSE_MODEL=models/yolov8n-pose.pt
YOLO_OBJECT_MODEL=models/yolov8n.pt
YOLO_WEAPON_MODEL=models/weapon_yolov8n.pt
YOLO_LP_MODEL=models/yolov8n-lp.pt
YUNET_FACE_MODEL=models/face_detection_yunet_2023mar.onnx
SFACE_FACE_MODEL=models/face_recognition_sface_2021dec.onnx

# AI Thresholds
YOLO_CONFIDENCE_THRESHOLD=0.45
FRS_SIMILARITY_THRESHOLD=0.40
ANPR_OCR_CONFIDENCE=0.60
ANPR_FUZZY_DISTANCE=2

# GPU
USE_GPU=false
GPU_DEVICE=cpu

# Surveillance Behaviour
LOITERING_TIMEOUT_SECONDS=10.0
ALERT_THROTTLE_SECONDS=3.0
MAX_CAMERAS=64
FRAME_SKIP_RATIO=2

# Storage
SNAPSHOT_DIR=snapshots
SNAPSHOT_JPEG_QUALITY=75
MAX_SNAPSHOT_RETENTION_DAYS=30
