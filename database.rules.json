{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "alerts": {
      ".indexOn": ["timestamp", "camera_id", "threat_level"],
      ".read": true,
      ".write": true
    },
    "telemetry": {
      ".read": true,
      ".write": true
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
      }
    }
  }
}
